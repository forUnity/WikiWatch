PREFIX p: <http://www.wikidata.org/prop/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

start = @<wikidata-familyname>

# sample items (some values used by P734):
# SELECT DISTINCT ?item { [] wdt:P734 ?item } LIMIT 100

# should pass: 
# SELECT DISTINCT ?item { ?item wdt:P31 wd:Q101352; ^wdt:P734 []; wdt:P1705 []; wdt:P3878 []; wdt:P282 [] } LIMIT 20

<wikidata-familyname> EXTRA p:P31 {    
	## STATEMENTS
	wdt:P31 [wd:Q101352];
        wdt:P3878 . ;
        wdt:P282 . ;
        wdt:P1705 . ;
}