PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

#query map:  SELECT ?item WHERE {?item wdt:P31 wd:Q55990535. } LIMIT 10

start =@<computer_model>
<computer_model> {

    # instance of
    wdt:P31 [ wd:Q55990535 ] ;
    # publication date or inception date 
	(  p:P577 { ps:P577 xsd:dateTime } ; p:P571 { ps:P571 xsd:dateTime } ?
	 | p:P571 { ps:P571 xsd:dateTime } ) *;
    # subclass of
    wdt:P279 [ <http://www.wikidata.org/entity>~ ] ? ;
    # manufacturer
    wdt:P176 [ <http://www.wikidata.org/entity>~ ] * ;
    # CPU; 
    wdt:P880 [ <http://www.wikidata.org/entity>~ ] ? ;
    # operating system
    wdt:P306 [ <http://www.wikidata.org/entity>~ ] * ;
    # official website
    wdt:P856 IRI ? ;
    # developer
    wdt:P178 [ <http://www.wikidata.org/entity>~ ] * ;
    # discontinued date
    wdt:P2669 xsd:dateTime ? ;
    # mass
    wdt:P2067 xsd:decimal * ;
    # units sold
    wdt:P2664 xsd:decimal * ;
    # volatile random-access memory capacity
    wdt:P2928 xsd:decimal ? ;
    # GPU
    wdt:P2560 [ <http://www.wikidata.org/entity>~ ] ? ;
    # total produced
    wdt:P1092 xsd:decimal ? ;
    # price
    wdt:P2284 xsd:decimal ? ;
    # image; 
    wdt:P18 [ <http://commons.wikimedia.org/wiki/Special:FilePath>~ ] ? ;
    }