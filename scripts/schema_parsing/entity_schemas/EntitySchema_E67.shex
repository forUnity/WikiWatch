# Querymap: SELECT * WHERE {?item wdt:P31 wd:Q618779 .} LIMIT 10

start = @<award>

<award> EXTRA p:P31 {
      #conferred by
      wdt:P1027 . *;

      #winner
      wdt:P1346 . ?;

      #grants
      wdt:P5460 . ?;

  # Data indications
      #instance of
      p:P31 { ps:P31  [wd:Q618779] };

      #country
      p:P17 { ps:P17  IRI * } ?;

      #Commons category
      p:P373 { ps:P373  xsd:string * } ?;

      #next higher rank
      p:P3730 { ps:P3730  IRI * } ?;

      #named after
      p:P138 { ps:P138  IRI * } ?;

      #subclass of
      p:P279 { ps:P279  IRI * } ?;

      #part of
      p:P361 { ps:P361  IRI * } ?;

      #located in the administrative territorial entity
      p:P131 { ps:P131  IRI * } ?;

      #inception
      p:P571 { ps:P571  xsd:dateTime *; psv:P571  IRI *;  } ?;

      #category for recipients of this award
      p:P2517 { ps:P2517  IRI * } ?;

      #service ribbon image
      p:P2425 { ps:P2425  IRI * } ?;

      #official website
      p:P856 { ps:P856  IRI * } ?;

      #next lower rank
      p:P3729 { ps:P3729  IRI * } ?;

      #conferred by
      p:P1027 { ps:P1027  IRI * } ?;

      #founded by
      p:P112 { ps:P112  IRI * } ?;

}