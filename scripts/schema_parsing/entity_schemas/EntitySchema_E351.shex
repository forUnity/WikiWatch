PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

#Query for validation: SELECT ?id WHERE {?id wdt:P31 wd:Q28885102 . }  LIMIT 10 

start = @<pharmaceutical_product>

<pharmaceutical_product> EXTRA wdt:P31 {
	wdt:P31 [ wd:Q28885102] ;
	wdt:P3781 @<pharmaceutical_product-P3781> + ;
	wdt:P4044 @<pharmaceutical_product-P4044> * ;
	wdt:P3345 . ? ;
	wdt:P7048 . ? ;
	wdt:P18 . * ;
	wdt:P3637 . ? ;
}

<pharmaceutical_product-P3781> EXTRA wdt:P31 {
	wdt:P31 [ wd:Q59199015 wd:Q113145171 wd:Q467717 wd:Q79529] ;
}

<pharmaceutical_product-P4044> EXTRA wdt:P31 {
	wdt:P31 [ wd:Q112193867] ;
}