IMPORT <https://www.wikidata.org/wiki/Special:EntitySchemaText/E264>
PREFIX E264: <https://www.wikidata.org/wiki/Special:EntitySchemaText/E264#>

PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdno: <http://www.wikidata.org/prop/novalue/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# SELECT ?lexeme { ?lexeme dct:language wd:Q12107; wikibase:lexicalCategory wd:Q24905 ; wdt:P5186 wd:Q54083637 }

start = @<breton-verb>

<breton-verb> {

  wikibase:lemma [ @br ]
    // rdf:label "verb"
    // rdf:comment "lemma must be Breton" ;

  dct:language [ wd:Q12107 ]
    // rdf:label  "Breton language"
    // rdf:comment "must be Breton language" ;

  wikibase:lexicalCategory [ wd:Q24905 ]
    // rdf:label "verb"
    // rdf:comment "lexeme must have verb as the lexical category" ;  

  wdt:P5187 [ @br ]
    // rdf:label "word stem"
    // rdf:comment "word stem must be Breton" ;
  
  wdt:P5186 [ wd:Q54083637 ] ;

  ontolex:lexicalForm @<breton-form> + ;
}

<breton-form> {
  ontolex:representation [ @br ] ;
  wikibase:grammaticalFeature IRI+
}