    "# Sample schema parsing for human (E10)\n",
    "import json\n",
    "from pyshex.utils.schema_loader import SchemaLoader\n",
    "\n",
    "with open(\"entity_schemas/EntitySchema_E10.shex\", \"r\", encoding=\"utf-8\") as f:\n",
    "    shex_text = f.read()\n",
    "\n",
    "loader = SchemaLoader()\n",
    "s = loader.loads(shex_text)\n",
    "s.__dict__"
