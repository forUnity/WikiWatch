PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

start = @<coronaviruslockdown>

<coronaviruslockdown>  EXTRA wdt:P31  {
  wdt:P31 [ wd:Q6665312  ] ;# instance of a lockdown
  wdt:P17 .{1} ;#country
  wdt:P131 .? ;#located in the administrative territorial entity
  wdt:P3014 .* ;#laws applied
  wdt:P361 [wd:Q87866152] ;#2019-2020 coronavirus disease pandemic
  wdt:P828 @<lockdowninstance> ;#has cause
  wdt:P580 .{1} ;#start time
  wdt:P1846 .* ;#distribution map
}

<lockdowninstance> {
  wdt:P31 [ wd:Q3241045  ] ;
}