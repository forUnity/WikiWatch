}

<series> EXTRA wdt:P31 {
  wdt:P31 [wd:Q7058673] +;
}

<franchise> EXTRA wdt:P31 {
  wdt:P31 [wd:Q196600] +;
}

<genre> EXTRA wdt:P31 {
  wdt:P31 [wd:Q659563] +;
}

<game_mode> EXTRA wdt:P31 {
  wdt:P31 [wd:Q1971694] +;
}

<country> EXTRA wdt:P31 {
  wdt:P31 [wd:Q6256 wd:Q7275] +;
}

<developer> EXTRA wdt:P31 {
  wdt:P31 [wd:Q5 wd:Q43229] +;
}

<publisher> EXTRA wdt:P31 {
  wdt:P31 [wd:Q5 wd:Q43229] +;
}

<platform> EXTRA wdt:P31 {
  wdt:P31 [wd:Q241317 wd:Q6368 wd:Q1406 wd:Q14116 wd:Q13522376 wd:Q388 wd:Q170434 wd:Q600659] +;
}

<engine> EXTRA wdt:P31 {
  wdt:P31 [wd:Q271680 wd:Q7397 wd:Q63533016] +;
}

<esrb_rating> EXTRA wdt:P31 {
  wdt:P31 [wd:Q23683568] +;
}

<pegi_rating> EXTRA wdt:P31 {
  wdt:P31 [wd:Q23686802] +;
}

<cero_rating> EXTRA wdt:P31 {
  wdt:P31 [wd:Q23683472] +;
}

<usk_rating> EXTRA wdt:P31 {
  wdt:P31 [wd:Q24561417] +;
}

<review_score> {
  pq:P447 . ; # review score by
  pq:P585 . ; # date
  pq:P400 @<platform> *; # platform(s)
}