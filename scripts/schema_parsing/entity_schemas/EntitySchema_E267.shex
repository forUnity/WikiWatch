# SELECT * WHERE { ?item wdt:P1433 wd:Q1569226 }

START = @<RDDM-article>

<RDDM-article> {
wdt:P31 [wd:Q191067 wd:Q17518557 wd:Q3331189 wd:Q17586363 wd:Q88392887] ;       #article ou série d'articles
