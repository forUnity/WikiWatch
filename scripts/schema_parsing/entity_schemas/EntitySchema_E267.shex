wdt:P407 [wd:Q150] ;     #langue française
wdt:P577 . * ;   #date de publication (0 ou plus valeurs)
wdt:P478 . ? ;    #volume de la revue (0 ou 1 valeur)
wdt:P304 . ? ;    #pages de la revue
wdt:P1476 . ? ;    #titre
wdt:P1680 . ? ;   #sous-titre
wdt:P50 . + ;  #auteur
