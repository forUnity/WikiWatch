#
# Sample queries for use with the schema checker:
# - SELECT ?item WHERE { ?item wdt:P31 wd:Q464980. } LIMIT 100
# - SELECT DISTINCT ?item WHERE { { SELECT DISTINCT ?item WHERE { ?item p:P31 ?statement0. ?statement0 (ps:P31/(wdt:P279*)) wd:Q667276.} } } LIMIT 100
#

PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

start = @<exhibition_concept>

<exhibition_concept> EXTRA  wdt:P31 {
	wdt:P31 [ wd:Q15275719 wd:Q133250] ; # 1 instance of Q1527519 or 133250; may have other values
	wdt:P1476 .   ;                      # 1 title
	wdt:P580  . ? ;                      # 0 or 1 start date
	wdt:P1619 . ? ;                      # 0 or 1 date of official opening
	wdt:P582  . ? ;                      # 0 or 1 end date
	wdt:P3999 . ? ;                      # 0 or 1 date of official closing
	wdt:P664  . * ;                      # 0 or more organizer
	wdt:P1640 . * ;                      # 0 or more curator
	wdt:P859  . * ;                      # 0 or more sponsor
	wdt:P1705 . * ;                      # 0 or more native label
	wdt:P856  . ? ;                      # 0 or 1 official website
	wdt:P112  . * ;                      # 0 or more founded by
	wdt:P18   . * ;                      # 0 or more image
	wdt:P154  . * ;                      # 0 or more logo image
	wdt:P921  . * ;                      # 0 or more main subject
	wdt:P972  . * ;                      # 0 or more catalog
}