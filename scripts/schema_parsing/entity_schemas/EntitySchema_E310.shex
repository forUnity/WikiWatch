PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>

## SPARQL query for English adjectives
# SELECT ?item { ?item dct:language wd:Q1860; wikibase:lexicalCategory wd:Q34698 } LIMIT 100

start = @<enadjective>
<enadjective> {
  dct:language [ wd:Q1860  ] ;#English lexeme
  wikibase:lexicalCategory [ wd:Q34698  ] ;#adjective lexical category
  ontolex:lexicalSense @<lexicalsense>* ;#senses
  ontolex:lexicalForm @<lexicalform1>{1} ;#positive
  ontolex:lexicalForm @<lexicalform2>? ;#comparative
  ontolex:lexicalForm @<lexicalform3>? ;#superlative
  ontolex:lexicalForm .* ;#other forms
}
<lexicalform1> {
  wikibase:grammaticalFeature [ wd:Q3482678  ] ;#positive
}
<lexicalform2> {
  wikibase:grammaticalFeature [ wd:Q3482678  ] ;#comparative
}
<lexicalform3> {
  wikibase:grammaticalFeature [ wd:Q1817208  ] ;#superlative
}
<lexicalsense> {
  rdfs:label .{1} ;#label
  skos:definition .{1} ;#label
  wdt:5137 .? ;#label
  wdt:5972 .? ;#label
}