PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>

# SELECT ?lexeme { ?lexeme dct:language wd:Q188 ; wikibase:lexicalCategory wd:Q24905 }

start = @<german-verb>

<german-verb> {
  dct:language [ wd:Q188 ] ;
  wikibase:lexicalCategory [ wd:Q24905 ] ;
  wikibase:lemma [ @de ] ;
  wdt:P5401 [ wd:L1761 wd:L4179 ] {1,2} ;
  ontolex:lexicalForm @<german-verb-form> + ;
}

<german-verb-form> {
  ontolex:representation [ @de ] ;
  wikibase:grammaticalFeature IRI+
}