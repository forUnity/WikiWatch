PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>

## SPARQL query for Malayalam nouns
# SELECT ?item { ?item dct:language wd:Q36236; wikibase:lexicalCategory wd:Q1084 } LIMIT 10

start = @<mlnoun>
<mlnoun> {
  dct:language [ wd:Q36236  ] ;#Malayalam lexeme
  wikibase:lexicalCategory [ wd:Q1084  ] ;#noun lexical category
  ontolex:lexicalSense @<lexicalsense>* ;#senses
  ontolex:lexicalForm @<lexicalform1>{1} ;#singular
  ontolex:lexicalForm @<lexicalform2>{1} ;#plural
  ontolex:lexicalForm .* ;#other forms
}
<lexicalform1> {
  wikibase:grammaticalFeature [ wd:Q110786  ] ;#singular
}
<lexicalform2> {
  wikibase:grammaticalFeature [ wd:Q146786  ] ;#plural
}
<lexicalsense> {
  rdfs:label .{1} ;#label
  skos:definition .{1} ;#label
  wdt:5137 .? ;#label
  wdt:5972 .? ;#label
}