# Example queries:
# 10 items:
# SELECT DISTINCT ?item WHERE {
#     ?item wdt:P31 wd:Q125469362
# } LIMIT 10
# Specific item (Q124661987):
# SELECT DISTINCT ?item WHERE {
#     VALUES ?item { wd:Q124661987 }
# }

start = @<locationTKU>

<locationTKU> {
    # @see https://www.wikidata.org/wiki/MediaWiki:Wikibase-SortedProperties

    # Statements

    # REQUIRED
    # property: instance of
    # value: Q125469362
    p:P31 {
        ps:P31 [ wd:Q125469362 ] ;
    } ;

    # REQUIRED
    # property: instance of
    # value: single or multuple items, excluding Q125469362
    p:P31 {
        ps:P31 [ wd:~ - wd:Q125469362 ] ;
