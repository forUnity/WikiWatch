PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

start = @<video_game>

<video_game> EXTRA wdt:P31 {
  ## Core properties
  wdt:P31 [ wd:Q7889 ] ;    # instance of video game
  wdt:P136 @<genre> +;      # genre
  wdt:P123 @<publisher> *;  # publisher
  wdt:P178 @<developer> *;  # developer
  wdt:P400 @<platform> +;   # platforms
  wdt:P495 @<country> ;     # country of origin
  wdt:P577 . *;             # publication date

  ## Main properties
  wdt:P1476 . ;             # title
  wdt:P6949 . ?;            # announcement date
  wdt:P856 . ?;             # official website
  wdt:P750 . *;             # distributed by
  wdt:P437 . *;             # distribution format
  wdt:P407 . *;             # language of work or name

  wdt:P408 @<engine> *;     # engine
  wdt:P479 . *;             # input method

  ## Gameplay
  wdt:P404 @<game_mode> +;  # game mode
  wdt:P4151 . ?;            # game mechanics

  ## Characters and setting
  wdt:P8411 . *;            # set in environment
  wdt:P1434 . ?;            # takes place in fictional universe
  wdt:P2408 . ?;            # set in period
  wdt:P840 . *;             # narrative location

  ## Staff
  wdt:P57 @E10:human ?;     # director
  wdt:P86 @E10:human *;     # composer
  wdt:P943 @E10:human *;    # programmer
  wdt:P162 @E10:human *;    # producer
  wdt:P287 @E10:human *;    # designed by

  ## Relationships to other works
  wdt:P144 . *;             # based on
  wdt:P179 @<series> *;     # series
  wdt:P941 . *;             # inspired by
  wdt:P8345 @<franchise> *; # media franchise
  wdt:P5940 . ?;            # plot expanded in

  ## Reception
  wdt:P1411 . *;            # nominated for
  wdt:P166 . *;             # award received
  p:P444 @<review_score> *; # review score
  wdt:P2664 . ?;            # units sold

  ## Wikidata housekeping
  wdt:P1889 . *;            # different from

  ## Rating systems
  wdt:P852 @<esrb_rating> ?; # ESRB Rating
  wdt:P908 @<pegi_rating> ?; # PEGI Rating
  wdt:P853 @<cero_rating> ?; # CERO Rating
  wdt:P914 @<usk_rating> ?;  # USK Rating


  ## External IDs
  wdt:P214 . ?;   # VIAF ID
  wdt:P244 . ?;   # Library of Congress authority ID
  wdt:P268 . ?;   # Bibliothèque nationale de France ID
  wdt:P345 . ?;   # IMDb ID
  wdt:P600 . ?;   # Wine App ID
  wdt:P646 . ?;   # Freebase ID
  wdt:P1712 . *;  # Metacritic ID
  wdt:P1733 . *;  # Steam Application ID
  wdt:P1933 . ?;  # MobyGames ID
  wdt:P2163 . ?;  # FAST ID
  wdt:P2671 . ?;  # Google Knowledge Graph ID
  wdt:P2725 . ?;  # GOG application ID
  wdt:P2816 . ?;  # HowLongToBeat ID
  wdt:P2864 . ?;  # OpenCritic ID
  wdt:P3418 . ?;  # Google Play Store app ID
  wdt:P3861 . ?;  # App Store app ID
  wdt:P4073 . ?;  # Fandom wiki ID
  wdt:P4467 . ?;  # Twitch category ID
  wdt:P4685 . ?;  # Nintendo of America Game Store ID (former scheme)
  wdt:P4477 . ?;  # Humble Store ID
