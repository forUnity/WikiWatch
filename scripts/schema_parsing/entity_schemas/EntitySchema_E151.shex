PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX p: <http://www.wikidata.org/prop/>

# Example query: SELECT DISTINCT ?items WHERE {VALUES ?items {wd:Q25173} ?items ?p ?o . }

start=@<watercraft>

<watercraft> {
        p:P31 @<P31_instance_of> ;
        p:P31 {}* # any other classes
}

<P31_instance_of> {
        ps:P31 @<subclass_of_watercraft> ;
}

<subclass_of_watercraft> [
        wd:Q42889 # vehicle
        wd:Q50380212 # floating object
] OR {
        wdt:P279 @<subclass_of_watercraft> ;
        wdt:P279 {}* # any other classes
}