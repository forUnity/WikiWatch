    # value: none, single or multuple items
    #
    # OPTIONAL
    # qualifier: P898 IPA transcription
    # value: none, single or multuple items
    p:P1448 {
        ps:P1448 [ @zh-hant ] ;
        pq:P1721 xsd:string ;
    } ;

    p:P1448 {
        ps:P1448 [ @zh-tw ] ;
