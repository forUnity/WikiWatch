start = @<#wikidata_software_company>

# Query with results:

<#wikidata_software_company> EXTRA p:P31 p:P279  {
	# STATEMENTS
	
	
	p:31 {ps:P31 [wd:Q4830453]} ;		

	p:P279  @<E73#P279_business-parent-class>* ;

	p:1056 @<E73#P1056_product_or_material_produced>* ;		
	
	p:452 @<E73#P452_industry>* ;

        p:P571 xsd:dateTime ? ;

 	p:P159 [ <http://www.wikidata.org/entity>~ ] * ;
	
	# IDENTIFIERS

  
  	p:2088 @<E73#P2088_crunchbase_organization_id>* ;

	p:1320 @<E73#P1320_open_corporates_id>* ;

 	p:213  @<E73#P213_ISNI>* ;

  	p:3500 @<E73#P3500_RingoldID>* ;

  	p:2427 @<E73#P2427_GRIDid>* ;

  	p:3153 @<E73#P3153_CrossRef>* ;

 	p:214 @<E73#P214_VIAF>* ;
}

